    "servers": [
      "1.1.1.1",
      "1.0.0.1"
    ],
    "queryStrategy": "UseIP"
  },
  "policy": {
    "levels": {
      "0": {
        "connIdle": 1800
      }
    }
  },
  "routing": {
    "rules": [
      {
        "type": "field",
        "domain": [
          "domain:youtube.com",
          "domain:youtu.be",
          "domain:googlevideo.com",
          "domain:ytimg.com",
          "domain:youtubei.googleapis.com",
          "domain:yt3.ggpht.com"
        ],
        "balancerTag": "RU_RELIEF"
      },
      {
        "type": "field",
        "protocol": [
          "bittorrent"
        ],
        "outboundTag": "direct"
      }
    ],
    "balancers": [
      {
        "tag": "RU_RELIEF",
        "selector": [
          "relief"
        ],
        "strategy": {
          "type": "leastLoad",
          "settings": {
            "maxRTT": "1800ms",
            "expected": 3,
            "baselines": [
              "90ms",
              "180ms",
              "350ms"
            ]
          }
        },
        "fallbackTag": "relief"
      }
    ],
    "domainMatcher": "hybrid",
    "domainStrategy": "IPIfNonMatch"
  },
