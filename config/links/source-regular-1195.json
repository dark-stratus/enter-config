        "balancerTag": "RU_RELIEF"
      },
      {
        "type": "field",
        "protocol": [
          "bittorrent"
        ],
        "outboundTag": "direct"
      }
    ],
    "balancers": [
      {
        "tag": "RU_RELIEF",
        "selector": [
          "relief"
        ],
        "strategy": {
          "type": "leastLoad",
          "settings": {
            "maxRTT": "1800ms",
            "expected": 3,
            "baselines": [
              "90ms",
              "180ms",
              "350ms"
            ]
          }
        },
        "fallbackTag": "relief"
      }
    ],
    "domainMatcher": "hybrid",
    "domainStrategy": "IPIfNonMatch"
  },
